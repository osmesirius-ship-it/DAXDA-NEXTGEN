# file: examples/.env.example

# DAX_ENV: The environment in which DAX is running (e.g., development, production).
# Required
DAX_ENV=development

# DAX_API_PORT: The port on which the DAX API will listen.
# Required
DAX_API_PORT=8000

# DATABASE_URL: Connection string for the primary database.
# Required
DATABASE_URL="postgresql://user:password@host:port/database_name"

# REDIS_URL: Connection string for Redis, used for caching or task queues.
# Optional (only if Redis is used)
REDIS_URL="redis://localhost:6379/0"

# MODEL_ENDPOINT: The URL for the AI model API that DAX will interact with.
# Required (if AI models are integrated)
MODEL_ENDPOINT="http://localhost:1234/v1"

# MODEL_API_KEY: API key for authenticating with the AI model endpoint.
# Required (if MODEL_ENDPOINT requires authentication)
MODEL_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# SECRET_KEY: A secret key used for cryptographic operations, such as session management or token signing.
# Required
SECRET_KEY="your_very_long_and_random_secret_key_here"

# LOG_LEVEL: The minimum logging level to output (e.g., DEBUG, INFO, WARNING, ERROR, CRITICAL).
# Optional
LOG_LEVEL=INFO

# ALLOWED_HOSTS: A comma-separated list of hosts/domains that the application should respond to.
# Optional (often required in production environments)
ALLOWED_HOSTS="localhost,127.0.0.1"
